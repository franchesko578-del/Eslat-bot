# Bu fayl NAMUNA. Haqiqiy qiymatlarni Render'dagi Environment bo'limiga yozing.
# Kompyuterda sinash uchun bu faylni .env nomiga ko'chiring (.env GitHub'ga YUKLANMAYDI).

# BotFather bergan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_yoki_secret_kalit

# Admin Telegram ID
ADMIN_ID=7507192517

# Vaqt zonasi (O'zbekiston)
TIMEZONE=Asia/Tashkent

# Qo'shimcha (o'zgartirish shart emas)
CHECK_INTERVAL=10
MAX_REMINDERS_PER_USER=100
